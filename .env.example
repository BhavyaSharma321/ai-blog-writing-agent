# Writing LLM: groq | gemini (leave empty = auto-pick whichever key is set)
LLM_PROVIDER=groq
# Optional default model (can also be picked from the dropdown in the app)
LLM_MODEL=

# Fill at least one of these (https://console.groq.com/keys, https://aistudio.google.com/apikey)
GROQ_API_KEY=
GOOGLE_API_KEY=

# Optional - web research (https://app.tavily.com)
TAVILY_API_KEY=

# Image generation uses GOOGLE_API_KEY
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Images: auto | mermaid | openverse | gemini  (auto/mermaid/openverse are free, no key)
IMAGE_SOURCE=auto
