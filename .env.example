# Writing LLM: groq | gemini | openai (leave empty = auto-pick whichever key is set)
LLM_PROVIDER=groq
# Optional model override (defaults: groq=llama-3.3-70b-versatile, gemini=gemini-2.5-flash, openai=gpt-4o-mini)
LLM_MODEL=

# Fill at least one of these (https://console.groq.com/keys, https://aistudio.google.com/apikey)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional - web research (https://app.tavily.com)
TAVILY_API_KEY=

# Image generation uses GOOGLE_API_KEY
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
