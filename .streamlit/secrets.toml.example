# Copy to .streamlit/secrets.toml locally, or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
LLM_PROVIDER = "groq"          # groq | gemini
GROQ_API_KEY = "gsk_..."
GOOGLE_API_KEY = "AIza..."     # optional: Gemini text / AI images
IMAGE_SOURCE = "auto"          # auto | mermaid | openverse | gemini
TAVILY_API_KEY = ""            # optional, enables web research
